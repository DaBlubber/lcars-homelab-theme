; ============================================================================
; VORLAGE - NICHT DIREKT ANWENDEN
; Diese Datei enthaelt absichtlich den ungueltigen Platzhalter
; __ZIELVERZEICHNIS__. Erst installieren.ps1 kopiert die Ressourcen, ersetzt den
; Platzhalter durch einen absoluten Pfad und oeffnet die fertige Theme-Datei.
; ============================================================================

[Theme]
DisplayName=LCARS-Homelab
SetLogonBackground=0

[Control Panel\Cursors]
AppStarting=%SystemRoot%\cursors\aero_working.ani
Arrow=%SystemRoot%\cursors\aero_arrow.cur
Crosshair=
Hand=%SystemRoot%\cursors\aero_link.cur
Help=%SystemRoot%\cursors\aero_helpsel.cur
IBeam=
No=%SystemRoot%\cursors\aero_unavail.cur
NWPen=%SystemRoot%\cursors\aero_pen.cur
SizeAll=%SystemRoot%\cursors\aero_move.cur
SizeNESW=%SystemRoot%\cursors\aero_nesw.cur
SizeNS=%SystemRoot%\cursors\aero_ns.cur
SizeNWSE=%SystemRoot%\cursors\aero_nwse.cur
SizeWE=%SystemRoot%\cursors\aero_ew.cur
UpArrow=%SystemRoot%\cursors\aero_up.cur
Wait=%SystemRoot%\cursors\aero_busy.ani
DefaultValue=Windows Default
DefaultValue.MUI=@main.cpl,-1020

[Control Panel\Desktop]
Wallpaper=__ZIELVERZEICHNIS__\wallpapers\rahmen-1920x1080.png
TileWallpaper=0
WallpaperStyle=10
Pattern=

[VisualStyles]
Path=%ResourceDir%\Themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
ColorizationColor=0XC41740BC
SystemMode=Dark
AppMode=Dark

[boot]
SCRNSAVE.EXE=

[MasterThemeSelector]
MTSM=RJSPBS

[Sounds]
; Der Installer registriert diesen Namen nicht direkt. Siehe README zum
; ungeprueften Importverhalten und zum belegbaren manuellen Weg.
SchemeName=LCARS-Homelab

[AppEvents\Schemes\Apps\.Default\.Default\.Current]
DefaultValue=__ZIELVERZEICHNIS__\sounds\standard.wav

[AppEvents\Schemes\Apps\.Default\SystemHand\.Current]
DefaultValue=__ZIELVERZEICHNIS__\sounds\fehler.wav

[AppEvents\Schemes\Apps\.Default\Notification.Default\.Current]
DefaultValue=__ZIELVERZEICHNIS__\sounds\benachrichtigung.wav

[AppEvents\Schemes\Apps\.Default\DeviceConnect\.Current]
DefaultValue=__ZIELVERZEICHNIS__\sounds\geraet-verbunden.wav

[AppEvents\Schemes\Apps\.Default\DeviceDisconnect\.Current]
DefaultValue=__ZIELVERZEICHNIS__\sounds\geraet-getrennt.wav

[Slideshow]
Interval=1800000
Shuffle=0
ImagesRootPath=__ZIELVERZEICHNIS__\wallpapers
Item0Path=__ZIELVERZEICHNIS__\wallpapers\rahmen-1920x1080.png
Item1Path=__ZIELVERZEICHNIS__\wallpapers\signal-1920x1080.png
